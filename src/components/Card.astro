---
export interface Props {
  title: string;
  description?: string;
  href?: string;
}

const { title, description, href } = Astro.props;

const Tag = href ? 'a' : 'div';
---

<Tag
  href={href}
  class:list={[
    'group block rounded-xl border border-gray-200 bg-white p-6 shadow-sm transition-shadow',
    href &&
      'hover:border-gray-300 hover:shadow-md focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:outline-none',
  ]}
>
  <h3 class="mb-2 text-lg font-semibold text-gray-900">
    {title}
  </h3>
  {description && <p class="text-sm leading-relaxed text-gray-600">{description}</p>}
  <slot />
</Tag>
